# Supabase
SUPABASE_URL=
# Server-only Supabase credential (NEVER expose to the browser/templates/JS).
# Prefer the newer "Secret key" (sb_secret_...). The service-role key is also
# accepted via SUPABASE_SERVICE_ROLE_KEY. SUPABASE_KEY is a legacy fallback
# kept only for a smooth transition and should be removed once migrated.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_KEY=

# Moneris
MONERIS_ENV=sandbox
MONERIS_ENABLED=false
MONERIS_CLIENT_ID=
MONERIS_CLIENT_SECRET=
MONERIS_MERCHANT_ID=
MONERIS_API_BASE_URL=https://api.sb.moneris.io
MONERIS_API_VERSION=2025-08-14
MONERIS_HOSTED_TOKENIZATION_PROFILE_ID=
MONERIS_HOSTED_TOKENIZATION_URL=https://esqa.moneris.com/HPPtoken/index.php

# Email (Gmail SMTP for booking confirmations)
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=