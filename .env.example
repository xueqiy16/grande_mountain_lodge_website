# Supabase
SUPABASE_URL=
# Server-only Supabase credential (NEVER expose to the browser/templates/JS).
# Prefer the newer "Secret key" (sb_secret_...). The service-role key is also
# accepted via SUPABASE_SERVICE_ROLE_KEY. SUPABASE_KEY is a legacy fallback
# kept only for a smooth transition and should be removed once migrated.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_KEY=

# Moneris (server-only). payment_api.load_config reads these only when the
# pending_v7 complete-payment path runs. Missing/invalid values must not
# break live_v6 startup while bookings are paused.
# MONERIS_ENV must be exactly sandbox or production. The two URL vars must
# match that env exactly; they are never rewritten to "fix" a mismatch.
# Do not set ENABLE_QA_CARD_VALIDATION on the website.
MONERIS_ENV=sandbox
MONERIS_ENABLED=false
MONERIS_CLIENT_ID=
MONERIS_CLIENT_SECRET=
MONERIS_MERCHANT_ID=
MONERIS_API_BASE_URL=https://api.sb.moneris.io
MONERIS_API_VERSION=2025-08-14
MONERIS_HOSTED_TOKENIZATION_PROFILE_ID=
MONERIS_HOSTED_TOKENIZATION_URL=https://esqa.moneris.com/HPPtoken/index.php

# Email (Gmail SMTP for booking confirmations)
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Public site origin used in confirmation-email cancellation links.
PUBLIC_SITE_URL=https://grandemountainlodge.com

# Dedicated HMAC secret for pending_v7 confirmation-email cancellation
# links. At least 32 characters. Do not reuse FLASK_SECRET_KEY,
# MONERIS_CLIENT_SECRET, Supabase keys, PAYMENT_EXPIRY_CRON_SECRET,
# or PAYMENT_RECONCILIATION_ADMIN_SECRET.
# Raw cancellation tokens are derived in memory and never stored.
# Required once CREATE_PUBLIC_BOOKING_CONTRACT=pending_v7; missing or
# short values skip the confirmation email (booking stays confirmed).
# CANCELLATION_TOKEN_SECRET=

# create_public_booking RPC contract. live_v6 = current production 6-arg
# function (confirmed bookings, no payment session). pending_v7 = sql/003
# 7-arg function. Keep live_v6 until 003 is applied. Do not auto-fallback:
# a 7-arg failure must not retry the 6-arg function, which would confirm
# without a payment session. Absent/blank defaults to live_v6. Any other
# explicit value fails closed (booking create and payment completion stop).
CREATE_PUBLIC_BOOKING_CONTRACT=live_v6

# Dedicated bearer secret for POST /api/internal/expire-payment-sessions.
# Required once CREATE_PUBLIC_BOOKING_CONTRACT=pending_v7 and sql/003 is
# applied. At least 32 characters. Do not reuse MONERIS_CLIENT_SECRET,
# the Supabase service-role key, confirmation tokens, payment-session
# tokens, or cancellation tokens. Do not put this on the query string.
# Scheduler-agnostic: keep this name even if a later Vercel Cron job
# uses CRON_SECRET internally — copy the value if needed, do not rename
# this endpoint to depend on Vercel.
# PAYMENT_EXPIRY_CRON_SECRET=

# Dedicated bearer secret for /api/internal/payment-reconciliation/*.
# Separate from PAYMENT_EXPIRY_CRON_SECRET. At least 32 characters.
# Ops control path only; not a LodgeOS staff UI. Do not put this on
# the query string. Do not reuse Moneris or Supabase secrets.
# PAYMENT_RECONCILIATION_ADMIN_SECRET=